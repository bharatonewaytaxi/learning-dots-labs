# Environment variables for Learning Dots Labs

# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application configuration
PORT=3000
NODE_ENV=development

# Lab provisioning configuration (example - adapt to your infrastructure)
LAB_PROVIDER=kubernetes
LAB_API_ENDPOINT=https://lab-api.example.com
LAB_API_KEY=your-lab-api-key
